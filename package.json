{
  "name": "wupi",
  "version": "0.24.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clear:webview2": "node scripts/clear-webview2-cache.cjs",
    "build": "npm run clear:webview2 && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "node scripts/cargo-check.cjs",
    "release": "node scripts/release.cjs",
    "sd:dev": "tauri dev -f diffusion-rs > logs/sd-out.log 2>&1",
    "sd:check": "cd src-tauri && cargo check --lib --no-default-features --features diffusion-rs",
    "sd:abort": "node scripts/sd-read-abort.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "adm-zip": "^0.6.0",
    "vite": "^6"
  }
}
