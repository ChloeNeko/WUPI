+/// WUPI PATCH (2026-08-15): recursively copy every built DLL from the cmake
+/// build tree into `target/<profile>` so the exe can load them at startup.
+fn copy_dlls(build_dir: &Path, target_dir: &Path) {
+    let Ok(entries) = read_dir(build_dir) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            copy_dlls(&path, target_dir);
+        } else if path.extension().and_then(|e| e.to_str()).map(|e| e.eq_ignore_ascii_case("dll")).unwrap_or(false) {
+            let dest = target_dir.join(entry.file_name());
+            if let Err(e) = std::fs::copy(&path, &dest) {
+                println!("cargo:warning=failed to copy {} -> {}: {}", path.display(), dest.display(), e);
+            }
+        }
+    }
