+    // name-based version detection (get_sd_version) is a CIRCULAR dependency
+    // for this layout: is_unet (used to pick the CLIP prefix) is derived from
+    // get_sd_version, which needs a token_embedding tensor (from CLIP) that
+    // isn't loaded yet → is_unet=false → CLIP-G gets the "text_encoders.*"
+    // prefix → version detection never sees cond_stage_model.1 → returns
+    // VERSION_COUNT → "get sd version from file failed".
+    //
+    // Fix: ComfyUI GGUFs carry their architecture in the `general.architecture`
+    // metadata key (verified: image.gguf = "sdxl"). Read it here and preset
+    // version_; get_sd_version() short-circuits on a preset version_ (see the
+    // early-return added at the top of get_sd_version). This breaks the circle
+    // without touching the detection heuristics for non-GGUF checkpoints.
+    if (version_ == VERSION_COUNT) {
+        gguf_context* ctx_arch = gguf_init_from_file(file_path.c_str(), {false, nullptr});
+        if (ctx_arch != nullptr) {
+            int64_t key_id = gguf_find_key(ctx_arch, "general.architecture");
+            if (key_id >= 0) {
+                const char* arch = gguf_get_val_str(ctx_arch, key_id);
+                if (arch != nullptr) {
+                    std::string arch_str(arch);
+                    LOG_INFO("gguf general.architecture = '%s'", arch_str.c_str());
+                    if (arch_str == "sdxl") {
+                        version_ = VERSION_SDXL;
+                    } else if (arch_str == "sd1") {
+                        version_ = VERSION_SD1;
+                    } else if (arch_str == "sd2" || arch_str == "sd2.x") {
+                        version_ = VERSION_SD2;
+                    } else if (arch_str == "flux") {
+                        version_ = VERSION_FLUX;
+                    } else if (arch_str == "sd3") {
+                        version_ = VERSION_SD3;
+                    }
+                    // Other architectures fall through; tensor-name detection
+                    // handles them (or returns VERSION_COUNT as before).
+                }
