+
     size_t file_index = add_file_path(file_path);
 
+    // ── WUPI PATCH (§11.59, Bug C): recover original shapes from ComfyUI metadata ──
+    // ComfyUI-quantized GGUFs store quantization-RESHAPED tensor dims on the
+    // tensor itself (e.g. a [3,3,4,320] conv weight becomes [256,45] after Q8_0
+    // block-packing). The TRUE original PyTorch shape is preserved in
+    // `comfy.gguf.orig_shape.<tensor_name>` metadata keys as an int32 array.
+    // sd.cpp's model validation (model_manager.cpp:450) compares each tensor's
+    // `ne` against the architecture's expected shape — without this fix EVERY
+    // conv/linear weight mismatches and validation fails ("model metadata
+    // validation failed"). ComfyUI/A1111 both read this key; sd.cpp (vendored
+    // 0.1.20) does not. Build a name→shape map here, then overwrite each
+    // tensor's ne (reversed: PyTorch [out,in,kH,kW] → ggml ne[0..3]=[kW,kH,in,out]).
+    std::unordered_map<std::string, std::vector<int64_t>> orig_shapes;
+    {
+        gguf_context* ctx_shape = gguf_init_from_file(file_path.c_str(), {false, nullptr});
+        if (ctx_shape != nullptr) {
+            int64_t n_kv = gguf_get_n_kv(ctx_shape);
+            for (int64_t i = 0; i < n_kv; i++) {
+                const char* key_cstr = gguf_get_key(ctx_shape, i);
+                if (key_cstr == nullptr) continue;
+                std::string key(key_cstr);
+                const std::string prefix_str = "comfy.gguf.orig_shape.";
+                if (key.size() <= prefix_str.size() ||
+                    key.compare(0, prefix_str.size(), prefix_str) != 0) {
+                    continue;
+                }
+                // Only int32 arrays are valid orig_shape entries.
+                if (gguf_get_kv_type(ctx_shape, i) != GGUF_TYPE_ARRAY) continue;
+                if (gguf_get_arr_type(ctx_shape, i) != GGUF_TYPE_INT32) continue;
