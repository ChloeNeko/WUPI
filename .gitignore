src/fable/data/

# Python bytecode caches.
__pycache__/

# Runtime playtest / debug captures (CUDA logs, etc.) — not source.
logs/

# Playtest harness workspace (CDP scripts, screenshots, console/stdout
# captures, transcripts, reports) — scratch, never source.
tmp/

# GLM prose-battle harness (scripts/model-battle) — local config holds the API
# key; results are run transcripts. The harness + scenario ARE source.
scripts/model-battle/config.json
scripts/model-battle/results/